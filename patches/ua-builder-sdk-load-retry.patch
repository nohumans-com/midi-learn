diff --git a/tests/unit/store-regressions.test.ts b/tests/unit/store-regressions.test.ts
index 79b0182..60fbc9c 100644
--- a/tests/unit/store-regressions.test.ts
+++ b/tests/unit/store-regressions.test.ts
@@ -134,3 +134,40 @@ describe('Store watches', () => {
     await store.close();
   });
 });
+
+describe('Retrying after a failed load (fact 103)', () => {
+  async function opened(tracks = ['Kick']) {
+    const { Luna } = await import('../../src/index');
+    const engine = new MockEngine();
+    engine.addSession('abc', { name: 'Opening', tracks });
+    await engine.settled();
+    const luna = await Luna.connect({ port_: engine.port() });
+    await luna.sessions.ready();
+    return { engine, luna, session: luna.sessions.current()! };
+  }
+
+  it('session.ready() asks again after a load that timed out, instead of replaying the failure', async () => {
+    const { engine, luna, session } = await opened();
+    engine.fail('/sessions/abc/tracks', 'timeout', 1); // LUNA still opening the session
+    await expect(session.ready()).rejects.toMatchObject({ code: 'timeout' });
+    await session.ready();
+    expect(session.visibleTracks.map((t) => t.name.value)).toEqual(['Kick']);
+    await luna.close();
+  });
+
+  it('collection.load() and node.load() forget a failure', async () => {
+    const { engine, luna, session } = await opened();
+    await session.ready();
+    const kick = session.visibleTracks[0]!;
+    engine.fail(kick.main.controls.path, 'timeout', 1);
+    await expect(kick.main.controls.load()).rejects.toMatchObject({ code: 'timeout' });
+    await kick.main.controls.load();
+    expect(kick.gain.display.value).toBe('0.0');
+    const solo = kick.controls.get('solo');
+    engine.fail(solo.path, 'timeout', 1);
+    await expect(solo.load()).rejects.toMatchObject({ code: 'timeout' });
+    await solo.load();
+    expect(solo.name.value).toBe('solo');
+    await luna.close();
+  });
+});
