{
  "name": "midi_learn",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "MIDI Learn, a LUNA Add On built with @uaudio/luna-builder-sdk",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "ua-builder serve",
    "install-addon": "ua-builder install",
    "pack": "ua-builder pack --no-vendor",
    "vendor": "node scripts/vendor-sdk.mjs",
    "bridge": "node bridge/midi-bridge.mjs",
    "bridge:install": "node bridge/agent.mjs install",
    "bridge:uninstall": "node bridge/agent.mjs uninstall",
    "bridge:status": "node bridge/agent.mjs status",
    "bridge:diag": "node bridge/agent.mjs diag",
    "installer": "bash installer/build.sh"
  },
  "devDependencies": {
    "@uaudio/luna-builder-sdk": "file:../../Library/Application Support/LUNA Builder SDK/plugins/ua-luna-builder",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@julusian/midi": "^3.8.1",
    "ws": "^8.22.0"
  }
}
