<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>MIDI Learn @VERSION@</title>
  <welcome file="welcome.html" mime-type="text/html"/>
  <conclusion file="conclusion.html" mime-type="text/html"/>
  <options customize="never" require-scripts="true" hostArchitectures="arm64,x86_64"/>
  <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
  <volume-check>
    <allowed-os-versions><os-version min="13.5"/></allowed-os-versions>
  </volume-check>
  <choices-outline>
    <line choice="default"/>
  </choices-outline>
  <choice id="default" title="MIDI Learn">
    <pkg-ref id="com.uaudio.midi-learn"/>
  </choice>
  <pkg-ref id="com.uaudio.midi-learn" version="@VERSION@" onConclusion="none">midi-learn.pkg</pkg-ref>
</installer-gui-script>
