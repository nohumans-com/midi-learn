#!/bin/sh
# Move the Add On into LUNA's Add Ons folder and start the bridge for whoever is logged in.
# Other users get the bridge at their next login, from /Library/LaunchAgents.
set -e
LABEL=com.uaudio.midi-learn.bridge
ID=com.uaudio.midi-learn
APP="/Library/Application Support/MIDI Learn"
ADDONS="/Library/Application Support/Universal Audio/LUNA/Add Ons"
user=$(stat -f%Su /dev/console)
case $user in root|loginwindow) user= ;; esac

mkdir -p "$ADDONS"
# LUNA needs each Add On's id to be unique: remove any earlier MIDI Learn, whatever its folder is
# called (opening a .lunaaddon names it midi-learn). A symlink loses only the link, not its target.
for entry in "$ADDONS"/*; do
  if grep -qs "\"id\": *\"$ID\"" "$entry/manifest.json"; then rm -rf "$entry"; fi
done
for addon in "$APP/Add On"/*; do
  rm -rf "$ADDONS/$(basename "$addon")"
  mv "$addon" "$ADDONS/"
  # LUNA's own Add Ons are the user's, so opening a newer .lunaaddon can replace this one.
  if [ -n "$user" ]; then chown -R "$user" "$ADDONS/$(basename "$addon")"; fi
done
rmdir "$APP/Add On"

if [ -n "$user" ]; then
  uid=$(id -u "$user")
  launchctl bootout "gui/$uid/$LABEL" 2>/dev/null || true
  launchctl bootstrap "gui/$uid" "/Library/LaunchAgents/$LABEL.plist"
fi
exit 0
